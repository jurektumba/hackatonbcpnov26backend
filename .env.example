# Copiar a .env y completar. NUNCA commitear .env.

# true = todas las tools usan mocks (default). false = usan las APIs reales.
USE_MOCKS=true
# Con USE_MOCKS=false se puede mantener en mock una herramienta puntual, por ejemplo:
#   MOCK_GITHUB=true  MOCK_CONFLUENCE=true   (Jira y OCD reales, el resto simulado)
MOCK_JIRA=
MOCK_JSM=
MOCK_GITHUB=
MOCK_CONFLUENCE=

# --- Jira Software vía jira-backend (persona 3) ---
# Servicio .NET jurektumba/jira-backend: guarda las credenciales de Atlassian y expone /api/*.
JIRA_GATEWAY_URL=http://localhost:8080
JIRA_GATEWAY_API_KEY=
JIRA_STORY_TYPE=Historia
# Tickets OCD: proyecto de Jira Software "OCD", tipo de issue "OCD" (flujo de 7 estados)
OCD_PROJECT_KEY=OCD
OCD_ISSUE_TYPE=OCD

# --- Atlassian Cloud (personas 3 y 4) ---
ATLASSIAN_BASE_URL=https://intellihack.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_PROJECT_KEY=GRUP
CONFLUENCE_SPACE_KEY=LIN
JSM_SERVICE_DESK_ID=
JSM_REQUEST_TYPE_ID=

# --- GitHub (persona 5) ---
GITHUB_TOKEN=
GITHUB_REPO=tu-org/demo-cloud-function

# --- Agente (persona 2) ---
AGENT_PORT=4000
