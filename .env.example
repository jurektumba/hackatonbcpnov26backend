# Copiar a .env y completar. NUNCA commitear .env.

# true = todas las tools usan mocks (default). false = usan las APIs reales.
USE_MOCKS=true

# --- Atlassian Cloud (personas 3 y 4) ---
ATLASSIAN_BASE_URL=https://tu-sitio.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_PROJECT_KEY=HACK
CONFLUENCE_SPACE_KEY=LIN
JSM_SERVICE_DESK_ID=
JSM_REQUEST_TYPE_ID=

# --- GitHub (persona 5) ---
GITHUB_TOKEN=
GITHUB_REPO=tu-org/demo-cloud-function

# --- Agente (persona 2) ---
AGENT_PORT=4000
